const body = "<!-- HERO -->\r\n<section class=\"hero\" id=\"top\">\r\n  <div class=\"hero-orb orb-1\"></div>\r\n  <div class=\"hero-orb orb-2\"></div>\r\n  <div class=\"hero-orb orb-3\"></div>\r\n  <div class=\"wrap page-hero\" style=\"display:block; max-width:760px;\">\r\n    <div class=\"breadcrumb\"><a href=\"index.html\">Inicio</a> / Aerotermia</div>\r\n    <div class=\"eyebrow\" style=\"color:var(--flame);\">Aerotermia</div>\r\n    <h1 style=\"color:#fff; font-size:clamp(34px,5vw,52px); margin-bottom:16px;\">Aerotermia en Madrid: calefacción, refrigeración y agua caliente con un solo equipo</h1>\r\n    <p class=\"lead\">Una bomba de calor aerotérmica aprovecha la energía gratuita del aire para calentar tu casa en invierno, refrescarla en verano y darte agua caliente todo el año, con hasta un 70% menos de consumo que una caldera convencional. Te hacemos un estudio técnico gratuito y te decimos, sin compromiso, si tu vivienda es apta.</p>\r\n    <div class=\"hero-ctas\" style=\"margin-top:26px;\">\r\n      <a href=\"index.html#contacto\" class=\"btn btn-flame\">Pedir presupuesto</a>\r\n      <a href=\"tel:+34919930168\" class=\"btn btn-ghost\">Llamar · 919 93 01 68</a>\r\n      <a href=\"https://wa.me/34651368631\" target=\"_blank\" rel=\"noopener\" class=\"btn btn-ghost\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"width:18px;height:18px;\"><path d=\"M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.87.5 3.62 1.44 5.15L2 22l5.09-1.53a9.87 9.87 0 0 0 4.95 1.31h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.79 14.16c-.24.68-1.4 1.3-1.93 1.36-.5.06-1.03.29-3.46-.72-2.91-1.21-4.78-4.15-4.93-4.35-.14-.19-1.17-1.56-1.17-2.98 0-1.41.74-2.1 1-2.39.26-.28.57-.36.77-.36.19 0 .38.001.55.01.18.01.42-.07.65.5.24.58.82 2 .9 2.15.07.14.12.31.02.5-.1.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.75 1.24 1.61 2 1.1.98 2.03 1.29 2.32 1.43.29.15.46.12.63-.07.17-.19.72-.84.92-1.13.19-.29.38-.24.65-.14.26.1 1.66.78 1.95.92.28.15.47.22.54.34.07.13.07.72-.17 1.4z\"/></svg>WhatsApp</a>\r\n    </div>\r\n  </div>\r\n</section>\r\n\r\n<div class=\"marquee\">\r\n  <div class=\"marquee-track\">\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z\"/></svg>Ahorro de hasta <b>70%</b> en calefacción y ACS</span>\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.7 6.3a4.5 4.5 0 0 0-6.4 6.4l7 7a2 2 0 0 0 2.8-2.8z\"/><path d=\"m5 21 4-4\"/></svg>Frío y calor con <b>un solo equipo</b></span>\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 8v4M12 16h.01\"/></svg>Estudio técnico <b>gratuito</b></span>\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\"/><line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"/></svg>Financiación a <b>12, 24 y 36 meses</b> sin intereses</span>\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg>Certificados <b>RITE</b></span>\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 1l2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L10 14.9 4.4 18l1.4-6.3L1 7.5l6.4-.6z\"/></svg><b>4.7★</b> en Google · +794 reseñas</span>\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z\"/></svg>Ahorro de hasta <b>70%</b> en calefacción y ACS</span>\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.7 6.3a4.5 4.5 0 0 0-6.4 6.4l7 7a2 2 0 0 0 2.8-2.8z\"/><path d=\"m5 21 4-4\"/></svg>Frío y calor con <b>un solo equipo</b></span>\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 8v4M12 16h.01\"/></svg>Estudio técnico <b>gratuito</b></span>\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\"/><line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"/></svg>Financiación a <b>12, 24 y 36 meses</b> sin intereses</span>\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg>Certificados <b>RITE</b></span>\r\n    <span class=\"marquee-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 1l2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L10 14.9 4.4 18l1.4-6.3L1 7.5l6.4-.6z\"/></svg><b>4.7★</b> en Google · +794 reseñas</span>\r\n  </div>\r\n</div>\r\n\r\n<!-- QUÉ ES -->\r\n<section class=\"section\" style=\"padding-top:64px;\">\r\n  <div class=\"wrap\" style=\"max-width:900px;\">\r\n    <div class=\"section-head reveal\">\r\n      <div class=\"eyebrow\">Aerotermia</div>\r\n      <h2>¿Qué es la aerotermia y cómo funciona?</h2>\r\n      <p>La aerotermia es un sistema de climatización que capta la energía del aire exterior, incluso con frío, y la convierte en calefacción, refrigeración y agua caliente sanitaria para tu vivienda. El corazón del sistema es una bomba de calor aire-agua: por cada kWh eléctrico que consume, puede entregar hasta 4 kWh de energía térmica, algo que ninguna caldera de combustión puede igualar.</p>\r\n    </div>\r\n    <div style=\"display:grid; gap:20px;\">\r\n      <div class=\"box reveal\" style=\"background:var(--aero-card-bg,#fff); border:1px solid var(--line); border-radius:var(--radius); padding:32px; display:flex; gap:22px; align-items:flex-start;\">\r\n        <div class=\"icon\" style=\"width:48px; height:48px; flex:none; border-radius:12px; background:var(--flame); display:flex; align-items:center; justify-content:center;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"23\" height=\"23\"><path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z\"/></svg></div>\r\n        <div>\r\n          <h3 style=\"font-size:22px; margin-bottom:8px;\">En invierno: calefacción y agua caliente</h3>\r\n          <p style=\"font-size:14.5px; color:var(--muted);\">La unidad exterior capta el calor del aire y lo transfiere, mediante un circuito de refrigerante, al agua que recorre tus radiadores, suelo radiante o fancoils, y al depósito de agua caliente sanitaria (ACS). Funciona incluso con temperaturas bajo cero.</p>\r\n        </div>\r\n      </div>\r\n      <div class=\"box reveal\" style=\"background:var(--aero-card-bg,#fff); border:1px solid var(--line); border-radius:var(--radius); padding:32px; display:flex; gap:22px; align-items:flex-start;\">\r\n        <div class=\"icon\" style=\"width:48px; height:48px; flex:none; border-radius:12px; background:var(--flame); display:flex; align-items:center; justify-content:center;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"23\" height=\"23\"><circle cx=\"12\" cy=\"12\" r=\"5\"/><path d=\"M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4\"/></svg></div>\r\n        <div>\r\n          <h3 style=\"font-size:22px; margin-bottom:8px;\">En verano: refrigeración</h3>\r\n          <p style=\"font-size:14.5px; color:var(--muted);\">El proceso se invierte: la bomba de calor extrae el calor del interior de la vivienda y lo expulsa fuera, refrescando la casa con el mismo equipo que calienta en invierno. Un único sistema para todo el año, sin instalar aire acondicionado aparte.</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section>\r\n\r\n<!-- VENTAJAS -->\r\n<section style=\"background:var(--cloud);\">\r\n  <div class=\"wrap\">\r\n    <div class=\"section-head center reveal\">\r\n      <div class=\"eyebrow\">Por qué merece la pena</div>\r\n      <h2>Ventajas de instalar aerotermia</h2>\r\n      <p>Cuatro razones por las que cada vez más viviendas en Madrid cambian su caldera por un equipo de aerotermia.</p>\r\n    </div>\r\n    <div class=\"values-grid reveal-stagger\">\r\n      <div class=\"value-card\">\r\n        <div class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z\"/></svg></div>\r\n        <h3>Ahorro real</h3>\r\n        <p>Entre un 50% y un 70% menos de consumo en calefacción y ACS frente a una caldera de gas o gasóleo, según el aislamiento de la vivienda.</p>\r\n      </div>\r\n      <div class=\"value-card\">\r\n        <div class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z\"/></svg></div>\r\n        <h3>Energía renovable</h3>\r\n        <p>El aire es una fuente gratuita e inagotable: menos emisiones de CO₂ y menos dependencia del gas o la electricidad de la red.</p>\r\n      </div>\r\n      <div class=\"value-card\">\r\n        <div class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.7 6.3a4.5 4.5 0 0 0-6.4 6.4l7 7a2 2 0 0 0 2.8-2.8z\"/><path d=\"m5 21 4-4\"/></svg></div>\r\n        <h3>Frío y calor en uno</h3>\r\n        <p>Calefacción, refrigeración y agua caliente sanitaria con un único equipo: ahorras el aire acondicionado aparte y el espacio que ocuparía.</p>\r\n      </div>\r\n      <div class=\"value-card\">\r\n        <div class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 12l2 2 4-4\"/><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg></div>\r\n        <h3>Bajo mantenimiento</h3>\r\n        <p>Menos piezas móviles que una caldera de combustión y sin necesidad de gas ni gasóleo: menos averías y revisiones más sencillas.</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section>\r\n\r\n<!-- PARA QUÉ VIVIENDAS -->\r\n<section class=\"section\">\r\n  <div class=\"wrap\">\r\n    <div class=\"section-head reveal\">\r\n      <div class=\"eyebrow\">¿Se adapta a tu vivienda?</div>\r\n      <h2>Aerotermia para cada tipo de hogar</h2>\r\n      <p>El diseño de la instalación cambia según el tipo de vivienda, pero la tecnología es la misma en todos los casos.</p>\r\n    </div>\r\n    <div class=\"values-grid reveal-stagger\">\r\n      <div class=\"value-card\">\r\n        <div class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 9.5 12 3l9 6.5V21a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z\"/><path d=\"M9 22V12h6v10\"/></svg></div>\r\n        <h3>Pisos y áticos</h3>\r\n        <p>Unidad exterior compacta en balcón, terraza o fachada, y conexión interior a radiadores de baja temperatura o suelo radiante.</p>\r\n      </div>\r\n      <div class=\"value-card\">\r\n        <div class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12l9-9 9 9M5 10v10h14V10\"/></svg></div>\r\n        <h3>Chalets y unifamiliares</h3>\r\n        <p>Más espacio para elegir la mejor ubicación del equipo y depósitos de ACS de mayor capacidad, incluso combinado con placas solares.</p>\r\n      </div>\r\n      <div class=\"value-card\">\r\n        <div class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\"/></svg></div>\r\n        <h3>Comunidades de vecinos</h3>\r\n        <p>Sistemas centralizados que sustituyen la caldera comunitaria de gasóleo o gas, repartiendo el ahorro entre todos los propietarios.</p>\r\n      </div>\r\n      <div class=\"value-card\">\r\n        <div class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"/></svg></div>\r\n        <h3>Obra nueva y reformas</h3>\r\n        <p>En obra nueva se integra desde el diseño; en reformas, estudiamos si conviene una instalación completa o adaptar la existente.</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section>\r\n\r\n<!-- INSTALACIÓN DECOGAS -->\r\n<div class=\"install-banner\">\r\n  <div class=\"wrap\">\r\n    <div class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/></svg></div>\r\n    <div>\r\n      <h4>Instalación de aerotermia en Madrid por técnicos propios</h4>\r\n      <p>Estudiamos tu vivienda sin coste, te recomendamos el equipo con la potencia adecuada y lo instalamos con nuestro propio equipo de técnicos certificados RITE, con presupuesto cerrado y garantía de 3 años.</p>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- CATÁLOGO -->\r\n<section class=\"products-section\">\r\n  <div class=\"wrap\">\r\n    <div class=\"section-head reveal\">\r\n      <div class=\"eyebrow\">Catálogo</div>\r\n      <h2>Equipos de aerotermia</h2>\r\n      <p>Estamos incorporando nuestra selección de bombas de calor aerotérmicas monobloc y bibloc. Mientras tanto, pídenos presupuesto y te asesoramos con el equipo que mejor encaja en tu vivienda.</p>\r\n    </div>\r\n\r\n    <div class=\"catalog-search reveal\">\r\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#5B6B7B\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m21 21-4.3-4.3\"/></svg>\r\n      <input type=\"text\" id=\"catalogSearch\" placeholder=\"Busca por nombre o marca…\" autocomplete=\"off\">\r\n    </div>\r\n    <div class=\"filter-bar reveal\" id=\"filterBar\">\r\n      <button class=\"filter-btn active\" data-filter=\"all\">\r\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/></svg>\r\n        Todo\r\n      </button>\r\n      <button class=\"filter-btn\" data-filter=\"brand\">\r\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg>\r\n        Por marcas\r\n      </button>\r\n      <button class=\"filter-btn\" data-filter=\"pop\">\r\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 1l2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L10 14.9 4.4 18l1.4-6.3L1 7.5l6.4-.6z\"/></svg>\r\n        Más vendido\r\n      </button>\r\n      <button class=\"filter-btn\" data-filter=\"cheap\">\r\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 19V5M5 12l7-7 7 7\"/></svg>\r\n        Más barato\r\n      </button>\r\n      <button class=\"filter-btn\" data-filter=\"expensive\">\r\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14M5 12l7 7 7-7\"/></svg>\r\n        Más caro\r\n      </button>\r\n      <button class=\"filter-btn\" data-filter=\"tipo\">\r\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\r\n        Tipo\r\n      </button>\r\n    </div>\r\n    <div class=\"sub-filter-bar\" id=\"subFilterBar\">\r\n      <button class=\"sub-chip\" data-type=\"monobloc\" type=\"button\">Monobloc</button>\r\n      <button class=\"sub-chip\" data-type=\"bibloc\" type=\"button\">Bibloc</button>\r\n    </div>\r\n\r\n    <div id=\"catalogRoot\"></div>\r\n  </div>\r\n</section>\r\n\r\n<!-- FAQ -->\r\n<section class=\"section\" style=\"background:var(--cloud);\">\r\n  <div class=\"wrap\" style=\"max-width:820px;\">\r\n    <div class=\"section-head reveal\">\r\n      <div class=\"eyebrow\">Preguntas frecuentes</div>\r\n      <h2>Dudas habituales sobre aerotermia</h2>\r\n    </div>\r\n    <details class=\"faq-item reveal\">\r\n      <summary>¿Cuánto se puede ahorrar con aerotermia frente a una caldera de gas?</summary>\r\n      <div class=\"faq-a\"><p>Depende del aislamiento de la vivienda y de la zona climática, pero lo habitual es un ahorro de entre el 50% y el 70% en calefacción y agua caliente sanitaria frente a una caldera de gas o gasóleo convencional.</p></div>\r\n    </details>\r\n    <details class=\"faq-item reveal\">\r\n      <summary>¿La aerotermia funciona en pisos y comunidades de vecinos?</summary>\r\n      <div class=\"faq-a\"><p>Sí. En pisos se instala una unidad exterior compacta en balcón, terraza o fachada. En comunidades de vecinos, además, es posible centralizar el sistema y sustituir la caldera comunitaria de gasóleo o gas.</p></div>\r\n    </details>\r\n    <details class=\"faq-item reveal\">\r\n      <summary>¿Puedo seguir usando mis radiadores actuales?</summary>\r\n      <div class=\"faq-a\"><p>Con radiadores de baja temperatura o sobredimensionados, normalmente sí. Si tus radiadores son antiguos y pequeños, puede convenir cambiarlos o combinarlos con suelo radiante para aprovechar mejor el rendimiento del equipo. Te lo confirmamos en la visita técnica.</p></div>\r\n    </details>\r\n    <details class=\"faq-item reveal\">\r\n      <summary>¿Hay ayudas o subvenciones para instalar aerotermia?</summary>\r\n      <div class=\"faq-a\"><p>Con frecuencia sí, tanto autonómicas como estatales, dentro de los planes de eficiencia energética y sustitución de calderas. Te informamos de las ayudas vigentes en Madrid en el momento de tu presupuesto.</p></div>\r\n    </details>\r\n    <details class=\"faq-item reveal\">\r\n      <summary>¿Cuánto dura la instalación de un equipo de aerotermia?</summary>\r\n      <div class=\"faq-a\"><p>Una sustitución sencilla puede resolverse en 1-2 días. En reformas más completas (cambio de emisores, suelo radiante, depósito de ACS) el plazo depende del alcance de la obra; te lo concretamos tras la visita técnica gratuita.</p></div>\r\n    </details>\r\n  </div>\r\n</section>\r\n\r\n<section class=\"final-cta\">\r\n  <div class=\"wrap\">\r\n    <h2>¿Quieres saber si la aerotermia es para ti?</h2>\r\n    <p>Te hacemos un estudio técnico gratuito de tu vivienda y te decimos, sin compromiso, el equipo y la potencia que necesitas.</p>\r\n    <a href=\"index.html#contacto\" class=\"btn btn-white\">Pedir asesoramiento</a>\r\n  </div>\r\n</section>";
