---
// Página autónoma (panel privado): head propio con estilos en línea, sin el layout de marketing.
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const V = 7; // fix real: grid 1fr sin minmax(0,..) no se encogia + overflow-x en html
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>(function(){try{var t=localStorage.getItem("decogas_theme");if(t!=="dark"&&t!=="light")t=(window.matchMedia&&matchMedia("(prefers-color-scheme:dark)").matches)?"dark":"light";document.documentElement.setAttribute("data-theme",t);}catch(e){}})();</script>
<meta name="robots" content="noindex, nofollow">
<title>Analíticas — Decogas</title>
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>
<link rel="stylesheet" href={`${base}fonts.css?v=1`}>
<style is:inline>
  :root{
    --navy:#0E2238; --navy-2:#16324B; --flame:#FF6B35; --flame-deep:#E2501C; --ice:#3AA6D9;
    --gold:#FFB930; --cloud:#F3F6F9; --line:#E2E8EF; --muted:#5B6B7B; --ok:#1E9E5A; --err:#D8433B;
  }
  *{ margin:0; padding:0; box-sizing:border-box; }
  html{ overflow-x:hidden; }
  body{ font-family:'Inter',sans-serif; background:var(--cloud); color:var(--navy); min-height:100vh; overflow-x:hidden; }

  h1,h2,h3{ font-family:'Fraunces',serif; }
  button{ font-family:'Inter',sans-serif; cursor:pointer; }

  #loginScreen{
    position:fixed; inset:0; display:flex; align-items:center; justify-content:center; padding:20px;
    background:
      radial-gradient(90% 120% at 85% -10%, rgba(58,166,217,.30), transparent 55%),
      radial-gradient(70% 90% at 5% 110%, rgba(255,107,53,.22), transparent 55%),
      linear-gradient(160deg, #0E2238 0%, #081729 100%);
    overflow:hidden; z-index:50; transition:opacity .5s, visibility .5s;
  }
  #loginScreen.hidden{ opacity:0; visibility:hidden; }
  .orb{ position:absolute; border-radius:50%; filter:blur(60px); opacity:.5; animation:float 9s ease-in-out infinite; }
  .orb.o1{ width:340px; height:340px; background:var(--ice); top:-90px; right:-60px; }
  .orb.o2{ width:280px; height:280px; background:var(--flame); bottom:-70px; left:-50px; animation-delay:-3s; }
  @keyframes float{ 0%,100%{ transform:translateY(0) scale(1); } 50%{ transform:translateY(-26px) scale(1.05); } }
  .login-card{
    position:relative; z-index:1; width:100%; max-width:420px; background:rgba(255,255,255,.98);
    border-radius:20px; padding:40px 36px 34px; box-shadow:0 30px 80px rgba(0,0,0,.35);
    animation:cardIn .7s cubic-bezier(.22,1,.36,1) both;
  }
  @keyframes cardIn{ from{ opacity:0; transform:translateY(26px) scale(.97); } to{ opacity:1; transform:none; } }
  .login-logo{ display:flex; align-items:center; gap:12px; margin-bottom:8px; }
  .login-logo .mark{
    width:44px; height:44px; border-radius:12px; background:var(--navy); color:#fff; display:flex;
    align-items:center; justify-content:center; font-family:'Fraunces'; font-weight:700; font-size:22px; position:relative; overflow:hidden;
  }
  .login-logo .mark::after{ content:""; position:absolute; inset:0;
    background:radial-gradient(60% 60% at 70% 30%, rgba(58,166,217,.55), transparent 70%),
               radial-gradient(60% 60% at 25% 80%, rgba(255,107,53,.55), transparent 70%); }
  .login-logo .mark span{ position:relative; z-index:1; }
  .login-logo h1{ font-size:24px; }
  .login-sub{ font-size:13.5px; color:var(--muted); margin-bottom:26px; }
  .field{ margin-bottom:16px; }
  .field label{ display:block; font-size:12.5px; font-weight:600; margin-bottom:6px; }
  .field input{ width:100%; padding:12px 14px; border:1.5px solid var(--line); border-radius:10px; font-size:14.5px; font-family:'Inter'; }
  .field input:focus{ outline:none; border-color:var(--ice); box-shadow:0 0 0 3px rgba(58,166,217,.15); }
  .btn{ display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:13px 24px;
    border-radius:11px; border:none; background:var(--flame); color:#fff; font-weight:600; font-size:14.5px;
    transition:transform .2s, background .2s; box-shadow:0 6px 18px rgba(255,107,53,.35); text-decoration:none; }
  .btn:hover{ background:var(--flame-deep); transform:translateY(-2px); }
  .btn:active{ transform:translateY(0) scale(.97); }
  .btn.ghost{ background:transparent; color:var(--muted); border:1.5px solid var(--line); box-shadow:none; }
  .btn.ghost:hover{ color:var(--navy); border-color:var(--muted); background:#fff; }
  .btn.small{ padding:9px 16px; font-size:13px; border-radius:9px; }
  .btn.block{ width:100%; }
  .msg{ font-size:13.5px; margin-top:12px; display:none; color:var(--err); }
  .msg.show{ display:block; }

  #panel{ display:none; }
  .admin-header{ background:linear-gradient(160deg, #0E2238 0%, #12293F 100%); color:#fff; padding:26px 0 74px; position:relative; overflow:hidden; }
  .admin-header .orb{ opacity:.35; }
  .wrap{ max-width:960px; margin:0 auto; padding:0 20px; position:relative; z-index:1; }
  .admin-topbar{ display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; }
  .admin-topbar h1{ font-size:24px; }
  .admin-topbar .right{ display:flex; align-items:center; gap:10px; }.hdr-link{ color:rgba(255,255,255,.8); border-color:rgba(255,255,255,.3); }.hdr-link:hover{ color:var(--navy); background:#fff; }
  .admin-sub{ margin-top:10px; font-size:14px; color:rgba(255,255,255,.75); max-width:560px; line-height:1.55; }
  .panel-body{ margin-top:-44px; padding-bottom:90px; }

  .section-card{
    background:#fff; border:1px solid var(--line); border-radius:16px; padding:24px; margin-bottom:26px;
    box-shadow:0 10px 30px rgba(14,34,56,.06); animation:cardIn .5s ease both;
  }
  .section-head{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:16px; }
  .section-head h2{ font-size:20px; display:flex; align-items:center; gap:10px; }
  .section-head .count{ font-family:'IBM Plex Mono'; font-size:11px; color:var(--muted); background:var(--cloud); padding:4px 10px; border-radius:999px; }.range-wrap{ position:relative; display:inline-flex; }.range-trigger{ display:inline-flex; align-items:center; gap:7px; font-family:'Inter'; font-size:13px; padding:8px 10px; border-radius:9px; border:1.5px solid var(--line); background:#fff; color:var(--navy); cursor:pointer; }.range-trigger .range-caret{ flex:none; transition:transform .2s; }.range-trigger[aria-expanded="true"] .range-caret{ transform:rotate(180deg); }.range-menu{ position:absolute; top:calc(100% + 6px); left:0; min-width:190px; background:#fff; border:1px solid var(--line); border-radius:12px; box-shadow:0 14px 34px rgba(14,34,56,.14); padding:6px; display:none; flex-direction:column; gap:2px; z-index:20; }.range-menu.open{ display:flex; }.range-opt{ text-align:left; border:none; background:transparent; border-radius:8px; padding:8px 10px; font-size:13px; font-weight:600; font-family:'Inter'; cursor:pointer; color:var(--navy); }.range-opt:hover{ background:var(--cloud); }.range-opt.active{ background:var(--ice); color:#fff; }

  #toast{ position:fixed; bottom:26px; left:50%; transform:translate(-50%, 80px); background:var(--navy); color:#fff; max-width:90vw; text-align:center; line-height:1.4;
    padding:13px 22px; border-radius:12px; font-size:14px; box-shadow:0 14px 34px rgba(0,0,0,.3);
    transition:transform .4s cubic-bezier(.22,1,.36,1); z-index:100; }
  #toast.show{ transform:translate(-50%, 0); }
  #toast.err{ background:var(--err); } [data-theme="dark"]{ --cloud:#0F1A25; --navy:#E6EEF6; --navy-2:#B9CBDC; --line:#26384B; --muted:#93A5B6; }[data-theme="dark"] body{ background:#0B131C; }[data-theme="dark"] .login-card{ background:#141F2C; }[data-theme="dark"] input, [data-theme="dark"] textarea, [data-theme="dark"] select{ background:#0F1A25; color:#E6EEF6; }[data-theme="dark"] input::placeholder, [data-theme="dark"] textarea::placeholder{ color:#5F7488; }[data-theme="dark"] .btn.ghost:hover{ background:#1B2A3A; }[data-theme="dark"] .section-card, [data-theme="dark"] .filters-card, [data-theme="dark"] .stats-pro, [data-theme="dark"] .prod, [data-theme="dark"] .lead, [data-theme="dark"] .stat-card{ background:#141F2C; }[data-theme="dark"] .prod:hover, [data-theme="dark"] .lead:hover{ border-color:#3A4C60; box-shadow:none; }[data-theme="dark"] .prod.hidden-prod{ background:#0F1A25; }[data-theme="dark"] .icon-btn, [data-theme="dark"] .photo-thumb{ background:#1B2A3A; }[data-theme="dark"] .chip{ background:#1B2A3A; border-color:#26384B; }[data-theme="dark"] .chip.active{ background:#173A5C; color:#fff; border-color:#173A5C; }[data-theme="dark"] .range-menu{ background:#141F2C; border-color:#26384B; }[data-theme="dark"] .range-opt{ color:#E6EEF6; }[data-theme="dark"] .range-opt:hover{ background:#1B2A3A; }[data-theme="dark"] .range-opt.active{ background:#173A5C; color:#fff; }[data-theme="dark"] .login-logo .mark{ background:#173A5C; }[data-theme="dark"] #toast{ background:#1B2A3A; }[data-theme="dark"] .switch .track{ background:#3A4C60; }[data-theme="dark"] .prod-form{ background:#0F1A25; }[data-theme="dark"] .prod-form-inner{ border-top-color:#26384B; }[data-theme="dark"] .mode-pill.demo{ background:#3A2A18; border-color:#5A3D28; }[data-theme="dark"] .mode-pill.live{ background:#12301F; border-color:#265F42; }[data-theme="dark"] .add-btn{ border-color:#3A4C60; }[data-theme="dark"] .add-btn:hover{ background:#2A2018; }[data-theme="dark"] .empty-state{ background:#141F2C; }[data-theme="dark"] .lead-msg, [data-theme="dark"] .prod-form-inner{ border-color:#26384B; }[data-theme="dark"] .theme-toggle-btn{ color:rgba(255,255,255,.85); }
.day-chart{ display:flex; align-items:flex-end; gap:5px; }
  .day-chart .aday{ flex:1; display:flex; flex-direction:column; align-items:center; gap:3px; cursor:pointer; }
  .analitica-lists{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:24px; }
@media(max-width:640px){
    .wrap{ padding:0 14px; }
    .section-card{ padding:16px 14px; }
    .admin-topbar h1{ font-size:20px; }
    .admin-topbar .right{ flex-wrap:wrap; }
    .section-head{ flex-wrap:wrap; }
    .section-head h2{ font-size:18px; }
    .range-wrap{ flex:1 1 100%; } .range-trigger{ width:100%; justify-content:space-between; }
    #analiticaDesde, #analiticaHasta{ flex:1 1 40%; }
    #analiticaRefresh{ flex:1 1 100%; min-height:44px; }
  }
  @media(max-width:700px){
    .day-chart{ gap:3px; overflow-x:auto; -webkit-overflow-scrolling:touch; padding-bottom:4px; }
    .day-chart .aday{ flex:0 0 20px; min-width:20px; }
  }
  @media(max-width:600px){
    .analitica-lists{ grid-template-columns:minmax(0,1fr); gap:18px; }
  }
</style>
</head>
<body>
<div id="loginScreen">
  <div class="orb o1"></div><div class="orb o2"></div>
  <div class="login-card">
    <div class="login-logo">
      <div class="mark"><span>D</span></div>
      <h1>Analíticas Decogas</h1>
    </div>
    <p class="login-sub">Visitas, contactos y comportamiento de la web.</p>
    <form id="loginForm">
      <div class="field">
        <label for="adminEmail">Email</label>
        <input type="email" id="adminEmail" autocomplete="username" required>
      </div>
      <div class="field">
        <label for="adminPass">Contraseña</label>
        <input type="password" id="adminPass" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn block" id="loginBtn">Entrar</button>
      <p class="msg" id="loginMsg"></p>
    </form>
  </div>
</div>

<div id="panel">
  <header class="admin-header">
    <div class="orb o1"></div><div class="orb o2"></div>
    <div class="wrap">
      <div class="admin-topbar">
        <h1>Analíticas</h1>
        <div class="right">
          <button class="btn ghost small theme-toggle-btn hdr-link" id="themeToggle" type="button" title="Modo claro / oscuro" aria-label="Cambiar tema">◐</button>
          <a class="btn ghost small hdr-link" href="admin.html" style=" text-decoration:none;">Catálogo</a>
          <a class="btn ghost small hdr-link" href="clientes.html" style=" text-decoration:none;">Clientes</a>
          <a class="btn ghost small hdr-link" href="cambios.html" style=" text-decoration:none;">Últimos cambios</a>
          <button class="btn ghost small hdr-link" id="logoutBtn" type="button">Salir</button>
        </div>
      </div>
      <p class="admin-sub">Visitas, visitantes, llamadas, WhatsApp y formularios recibidos desde la web, en tiempo casi real.</p>
    </div>
  </header>

  <div class="panel-body">
    <div class="wrap">
      <div class="section-card" id="analiticaCard">
        <div class="section-head">
          <h2>Analítica de la web</h2>
          <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <div class="range-wrap">
              <button type="button" class="range-trigger" id="analiticaRango" data-value="30" aria-haspopup="listbox" aria-expanded="false">
                <span id="analiticaRangoLabel">Últimos 30 días</span>
                <svg class="range-caret" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div class="range-menu" role="listbox">
                <button type="button" class="range-opt" data-value="7" role="option">Últimos 7 días</button>
                <button type="button" class="range-opt active" data-value="30" role="option" aria-selected="true">Últimos 30 días</button>
                <button type="button" class="range-opt" data-value="mesActual" role="option">Este mes</button>
                <button type="button" class="range-opt" data-value="mesAnterior" role="option">Mes anterior</button>
                <button type="button" class="range-opt" data-value="custom" role="option">Rango personalizado…</button>
              </div>
            </div>
            <input type="date" id="analiticaDesde" style="display:none; font-family:'Inter'; font-size:13px; padding:7px 9px; border-radius:9px; border:1.5px solid var(--line);">
            <span id="analiticaGuion" style="display:none; color:var(--muted);">&ndash;</span>
            <input type="date" id="analiticaHasta" style="display:none; font-family:'Inter'; font-size:13px; padding:7px 9px; border-radius:9px; border:1.5px solid var(--line);">
            <button class="btn ghost small" id="analiticaRefresh" type="button">Actualizar</button>
          </div>
        </div>
        <div id="analiticaBox"><p style="color:var(--muted); font-size:14px; padding:6px 0;">Cargando…</p></div>
      </div>
    </div>
  </div>
</div>

<div id="toast"></div>
<script src="vendor/supabase.min.js?v=1" is:inline></script>
<script src={`${base}utils.js?v=${V}`} is:inline></script>
<script src={`${base}config.js?v=${V}`} is:inline></script>
<script src={`${base}analiticas.js?v=${V}`} is:inline></script>
<script src={`${base}analitica.js?v=${V}`} is:inline></script>
<script>(function(){var b=document.getElementById("themeToggle");if(!b)return;b.addEventListener("click",function(){var d=document.documentElement.getAttribute("data-theme")==="dark";var n=d?"light":"dark";document.documentElement.setAttribute("data-theme",n);try{localStorage.setItem("decogas_theme",n);}catch(e){}});})();</script>
</body>
</html>
